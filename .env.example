# =====================================================================
# KosCycle — template environment variables
# Salin file ini menjadi `.env.local` lalu isi nilainya:
#   cp .env.example .env.local
# =====================================================================

# --- Database (Vercel Postgres / Neon) --------------------------------
# Vercel Dashboard → Storage → Create Database → Neon (Postgres)
# → tab ".env.local" → salin nilai DATABASE_URL (pakai yang "pooled").
# Atau jalankan: `vercel env pull .env.local` setelah `vercel link`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Better Auth -------------------------------------------------------
# Secret acak minimal 32 karakter. Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# URL aplikasi. Lokal: http://localhost:3000 — Produksi: https://domainmu.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cloudinary (upload foto barang & KTM) ----------------------------
# Cloudinary Console → Dashboard → "Product Environment Credentials"
CLOUDINARY_CLOUD_NAME="nama-cloud-kamu"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="rahasia-api-cloudinary"
# Sama dengan CLOUDINARY_CLOUD_NAME (dipakai di browser untuk menampilkan gambar)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="nama-cloud-kamu"
# Folder tujuan upload di Cloudinary (opsional)
CLOUDINARY_UPLOAD_FOLDER="koscycle"
